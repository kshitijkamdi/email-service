NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mini-gmail
# Optional: useful when Node cannot resolve MongoDB Atlas mongodb+srv records on local DNS.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
EMAIL_DOMAIN=mydomain.com
# Optional: comma-separated admin mailboxes. If empty, the first registered mailbox is admin.
ADMIN_EMAILS=admin@mydomain.com
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
COOKIE_SECURE=false
